# ESPN private-league auth (read from your browser cookies while logged into fantasy.espn.com)
ESPN_S2=
ESPN_SWID={your-swid-guid-with-braces}

# League settings
LEAGUE_ID=
TEAM_ID=
SEASON_YEAR=2026

# Slack incoming webhooks (personal workspace, one channel per automation)
SLACK_WEBHOOK_URL_LINEUP=
SLACK_WEBHOOK_URL_WAIVERS=
SLACK_WEBHOOK_URL_TRADES=

# Anthropic API key — used by reasoning.py to review lineup/waiver/trade
# candidates with web search before they're applied or suggested.
ANTHROPIC_API_KEY=

# Upstash Redis (free tier at upstash.com) — used by memory.py to remember
# past weeks' reasoning-layer decisions per player across scheduled runs.
# Optional: if unset, memory is silently skipped (no history in, nothing
# recorded) rather than breaking anything.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
